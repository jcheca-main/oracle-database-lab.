-- 3a. DBA_TABLES y V$SESSION: ORA-00942 esperado (no "sin privilegios": Oracle no revela lo que no puedes ver)
SELECT COUNT(*) FROM dba_tables
                     *
ERROR at line 1:
ORA-00942: table or view "SYS"."DBA_TABLES" does not exist
Help: https://docs.oracle.com/error-help/db/ora-00942/


SELECT COUNT(*) FROM v$session
                     *
ERROR at line 1:
ORA-00942: table or view "SYS"."V_$SESSION" does not exist
Help: https://docs.oracle.com/error-help/db/ora-00942/


-- 3b. Leer una tabla de negocio: ORA-00942 esperado
SELECT COUNT(*) FROM admin_academia.aca_estudiantes
                                    *
ERROR at line 1:
ORA-00942: table or view "ADMIN_ACADEMIA"."ACA_ESTUDIANTES" does not exist
Help: https://docs.oracle.com/error-help/db/ora-00942/


-- 3c. Saltar a la raíz: ORA-01031 esperado (no tiene SET CONTAINER y además no existe en la raíz)
ERROR:
ORA-01031: insufficient privileges
Help: https://docs.oracle.com/error-help/db/ora-01031/



